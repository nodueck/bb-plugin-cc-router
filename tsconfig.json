{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "server.ts",
    "server.test.ts",
    "contract.ts",
    "app.tsx",
    "app.test.tsx",
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
